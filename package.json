{
    "name": "auto-commit-message",
    "displayName": "Auto Commit Message Generator",
    "description": "Generate clean, conventional git commit messages from your staged changes with one click, right in the Source Control panel. Free built-in tier, no API key required.",
    "version": "1.0.11",
    "publisher": "AlirezaDavoodi",
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#1e1e2e",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "SCM Providers",
        "Machine Learning",
        "Other"
    ],
    "keywords": [
        "git",
        "commit",
        "commit message",
        "ai",
        "conventional commits",
        "source control",
        "scm",
        "openrouter",
        "claude"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "claude-commit-message.generate",
                "icon": "$(wand)",
                "title": "Generate Commit Message",
                "tooltip": "Generate Commit Message",
                "category": "Git"
            }
        ],
        "configuration": {
            "title": "Claude Commit Message",
            "properties": {
                "claudeCommitMessage.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "Optional: your own OpenRouter API key. Leave blank to use the built-in free tier.",
                    "scope": "application"
                },
                "claudeCommitMessage.model": {
                    "type": "string",
                    "default": "openrouter/free",
                    "description": "Which OpenRouter model to use",
                    "scope": "application"
                },
                "claudeCommitMessage.customPrompt": {
                    "type": "string",
                    "default": "Generate a commit message using conventional formats and follow previous commits formats",
                    "description": "Custom instruction prompt sent to Claude when generating commit messages",
                    "scope": "resource"
                }
            }
        },
        "menus": {
            "commandPalette": [
                {
                    "command": "claude-commit-message.generate",
                    "when": "gitOpenRepository"
                }
            ],
            "scm/title": [
                {
                    "command": "claude-commit-message.generate",
                    "group": "navigation",
                    "when": "scmProvider == git"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "clean": "rm -rf dist && rm -rf node_modules && npm install",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js",
        "postinstall": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "^18.11.18",
        "@types/vscode": "^1.75.1",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "diff": "^5.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/alireza-da/auto-commit-extension.git"
    },
    "bugs": {
        "url": "https://github.com/alireza-da/auto-commit-extension/issues"
    },
    "homepage": "https://github.com/alireza-da/auto-commit-extension#readme",
    "license": "MIT"
}
